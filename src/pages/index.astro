---
import SiteLayout from "../layouts/SiteLayout.astro";
import { modules, flatLessons } from "../data/curriculum.js";

const totalLessons = flatLessons.length;
---
<SiteLayout title="Home" description="Learn quantum computing and quantum machine learning in plain language — from everyday intuition to the real math." altUrl="/hi/">
  <div class="hero">
    <h1>Quantum computing, <span class="grad">explained for everyone.</span></h1>
    <p>
      Independent study notes for quantum computing and quantum machine learning, written from scratch.
      Every lesson starts in plain words anyone can follow — then goes as deep as you want, all the way to the real math.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/lessons/qubits/">Start Module 1 →</a>
      <a class="btn btn-ghost" href="#modules">Browse all modules</a>
    </div>
  </div>

  <a class="feature-banner" href="/quantum-year-2025/">
    <span class="kicker">Special feature · 2025</span>
    <strong>2025 is the International Year of Quantum Science and Technology</strong>
    <span class="sub">100 years of quantum mechanics — who declared it, why 2025, and the full story →</span>
  </a>

  <div class="card progress-card">
    <div class="progress-label" data-progress-text>0 of {totalLessons} lessons complete</div>
    <div class="progress-track"><div data-progress-bar></div></div>
  </div>

  <div class="steps">
    <div class="step">
      <div class="snum">Step 1</div>
      <p><strong>Read the simple version.</strong> Every lesson opens with a no-jargon explanation — spinning coins, light switches, real intuition.</p>
    </div>
    <div class="step">
      <div class="snum">Step 2</div>
      <p><strong>Go deeper when ready.</strong> Expand the rigorous section for Dirac notation, derivations, and the full mathematical picture.</p>
    </div>
    <div class="step">
      <div class="snum">Step 3</div>
      <p><strong>Test yourself.</strong> Quick quizzes with instant feedback, then mark the lesson complete and keep your streak.</p>
    </div>
  </div>

  <h2 id="modules">The {modules.length} modules</h2>
  <p class="lede">Follow the learning path in order, or jump to whatever you need. Use ← → arrow keys to turn pages.</p>

  <div class="module-grid">
    {modules.map((m) => (
      <a class="module-card" href={`/modules/${m.id}/`}>
        <span class="num">Module {m.number}</span>
        <h3>{m.title}</h3>
        <p>{m.tagline}</p>
        <span class="count">{m.lessons.length} lessons</span>
      </a>
    ))}
  </div>

  <p class="hint">Tip: press <kbd>←</kbd> and <kbd>→</kbd> on any lesson page to flip between lessons, like turning pages.</p>
</SiteLayout>
