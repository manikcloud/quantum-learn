---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { t } from "../../data/i18n.js";
---
<SiteLayout
  title={t("hi", "loginTitle")}
  description="Quantum Learning Hub में जाने के लिए Google से साइन इन करें।"
  lang="hi"
  noGate={true}
  altUrl="/login/"
>
  <div class="login-wrap" data-pagefind-ignore>
    <div class="login-card">
      <div class="brand-mark login-mark">Q</div>
      <h1>{t("hi", "loginTitle")}</h1>
      <p class="login-sub">{t("hi", "loginSub")}</p>
      <div id="login-err" class="login-err" hidden></div>
      <button id="google-btn" class="google-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.3-2.3H12v4.5h6.5c-.1 1.1-.8 2.7-2.4 3.8l3.6 2.8c2.2-2 3.8-5 3.8-8.8z"/>
          <path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.8-2.9c-1 .7-2.4 1.2-4.1 1.2-3.1 0-5.8-2.1-6.8-5l-3.9 3C3.5 21.3 7.5 24 12 24z"/>
          <path fill="#FBBC05" d="M5.2 14.4c-.2-.7-.4-1.5-.4-2.4s.1-1.7.4-2.4l-3.9-3C.5 8.3 0 10.1 0 12s.5 3.7 1.3 5.3l3.9-2.9z"/>
          <path fill="#EA4335" d="M12 4.7c1.8 0 3 .8 3.7 1.4l3.3-3.2C17.9 1.1 15.2 0 12 0 7.5 0 3.5 2.7 1.3 6.7l3.9 3c1-2.9 3.7-5 6.8-5z"/>
        </svg>
        <span>{t("hi", "continueWithGoogle")}</span>
      </button>
      <p class="login-note">{t("hi", "loginNote")}</p>
      <div id="login-authed" hidden>
        <p>{t("hi", "signedInAs")} <strong id="login-email"></strong></p>
        <p>
          <a id="login-continue" href="/hi/">{t("hi", "continueToSite")}</a>
          {" · "}
          <a href="#" id="login-switch">{t("hi", "switchAccount")}</a>
        </p>
      </div>
    </div>
  </div>

  {/* Login logic talks ONLY to the auth interface in /auth/
      (see public/auth/README.md) — zero provider-specific code here. */
  <script>
    (function () {
      var AUTH_BASE = "/auth/";
      var errBox = document.getElementById("login-err");
      var btn = document.getElementById("google-btn");
      var authedBox = document.getElementById("login-authed");
      function showErr(msg) { errBox.hidden = false; errBox.textContent = msg; }
      var params = new URLSearchParams(window.location.search);
      var next = params.get("next") || "/hi/";
      if (next.charAt(0) !== "/") next = "/hi/";
      if (params.get("denied") === "1") showErr("\u092f\u0939 Google account access list \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964");
      import(/* @vite-ignore */ AUTH_BASE + "config.js").then(function () {
        return import(/* @vite-ignore */ AUTH_BASE + "index.js");
      }).then(function (mod) {
        var auth = mod.auth;
        if (!auth.configured) {
          btn.disabled = true;
          showErr("\u0938\u093e\u0907\u0928-\u0907\u0928 \u0905\u092d\u0940 \u091c\u0941\u0921\u093e \u0928\u0939\u0940\u0902 \u0939\u0948 \u2014 setup \u091a\u0932 \u0930\u0939\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092c\u093e\u0926 \u092e\u0947\u0902 \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964");
          return;
        }
        auth.handleRedirect().then(function (res) {
          if (res.error) showErr(res.error.message || "\u0938\u093e\u0907\u0928-\u0907\u0928 \u0905\u0938\u092b\u0932 \u0930\u0939\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964");
        });
        auth.onAuthChange(function (user, info) {
          if (info && info.denied) {
            auth.signOut().then(function () { showErr("\u092f\u0939 Google account access list \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"); });
            return;
          }
          if (!user) return;
          authedBox.hidden = false;
          document.getElementById("login-email").textContent = user.email || user.displayName || "";
          document.getElementById("login-continue").setAttribute("href", next);
          btn.style.display = "none";
          setTimeout(function () { window.location.replace(next); }, 1200);
        }).catch(function () {
          showErr("\u0938\u093e\u0907\u0928-\u0907\u0928 \u0938\u0947\u0935\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0930\u0939\u0940 \u2014 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0901\u091a\u0947\u0902 \u0914\u0930 reload \u0915\u0930\u0947\u0902\u0964");
        });
        btn.addEventListener("click", function () { auth.signIn(); });
        document.getElementById("login-switch").addEventListener("click", function (e) {
          e.preventDefault();
          auth.signOut().then(function () { window.location.reload(); });
        });
      }).catch(function () {
        showErr("\u0938\u093e\u0907\u0928-\u0907\u0928 \u0938\u0947\u0935\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0930\u0939\u0940 \u2014 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0901\u091a\u0947\u0902 \u0914\u0930 reload \u0915\u0930\u0947\u0902\u0964");
      });
    })();
  </script>
</SiteLayout>
