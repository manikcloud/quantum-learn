---
// SlideDeck: a swipeable slide carousel section for lessons.
// Props: slides [{title, body, visual?}], deckId (unique per page),
// kicker, heading, prevLabel, nextLabel.
// Note: no global arrow-key binding here — the site layout already uses
// ←/→ for lesson pager navigation.
const { slides, deckId, kicker, heading, prevLabel = "← Prev", nextLabel = "Next →" } = Astro.props;
---
{slides?.length > 0 && (
  <section class="slide-deck" aria-label={heading} data-pagefind-ignore>
    <div class="kicker">{kicker}</div>
    <h2 class="deck-heading">{heading}</h2>
    <div class="deck-viewport" data-deck={deckId}>
      <div class="deck-track">
        {slides.map((s, i) => (
          <article class="deck-card" aria-label={`Slide ${i + 1} of ${slides.length}`}>
            <div class="deck-num">Slide {i + 1} / {slides.length}</div>
            {s.visual && <div class="deck-visual" set:html={s.visual} />}
            <h3>{s.title}</h3>
            <p set:html={s.body} />
          </article>
        ))}
      </div>
    </div>
    <div class="deck-controls">
      <button type="button" data-deck-prev aria-label={prevLabel}>{prevLabel}</button>
      <div class="deck-dots" role="tablist" aria-label={heading}>
        {slides.map((_, i) => (
          <button type="button" role="tab" aria-label={`Go to slide ${i + 1}`} data-deck-dot={i} class={i === 0 ? "on" : ""}></button>
        ))}
      </div>
      <button type="button" data-deck-next aria-label={nextLabel}>{nextLabel}</button>
    </div>
  </section>
)}

<style>
  .slide-deck { margin: 1.5rem 0 2rem; }
  .deck-heading { margin: 0.25rem 0 1rem; font-size: 1.4rem; }
  .deck-viewport { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow); touch-action: pan-y; }
  .deck-track { display: flex; transition: transform 0.35s ease; }
  .deck-card { flex: 0 0 100%; box-sizing: border-box; padding: 1.5rem 1.5rem 1.75rem; min-height: 320px; text-align: center; }
  .deck-num { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.75rem; }
  .deck-visual { margin: 0 auto 1rem; max-width: 280px; color: var(--accent); }
  .deck-visual svg { width: 100%; height: auto; max-height: 150px; display: block; }
  .deck-card h3 { margin: 0 0 0.6rem; font-size: 1.2rem; }
  .deck-card p { line-height: 1.65; color: var(--text); margin: 0 auto; max-width: 34rem; }
  .deck-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.9rem; }
  .deck-controls button { cursor: pointer; border: 1px solid var(--border); background: var(--card); color: var(--text); border-radius: var(--radius); padding: 0.5rem 1rem; font-size: 0.95rem; }
  .deck-controls button:hover { background: var(--card-hover); }
  .deck-dots { display: flex; gap: 0.45rem; flex-wrap: wrap; justify-content: center; }
  .deck-dots button { width: 0.8rem; height: 0.8rem; border-radius: 50%; padding: 0; border: 1px solid var(--border); background: transparent; }
  .deck-dots button.on { background: var(--accent); border-color: var(--accent); }
</style>

<script>
  (function () {
    document.querySelectorAll(".slide-deck").forEach(function (deck) {
      var viewport = deck.querySelector(".deck-viewport");
      var track = deck.querySelector(".deck-track");
      var dots = Array.prototype.slice.call(deck.querySelectorAll("[data-deck-dot]"));
      var prev = deck.querySelector("[data-deck-prev]");
      var next = deck.querySelector("[data-deck-next]");
      var i = 0, total = dots.length;
      function go(n) {
        i = (n + total) % total;
        track.style.transform = "translateX(-" + i * 100 + "%)";
        dots.forEach(function (d, k) { d.classList.toggle("on", k === i); });
      }
      prev.addEventListener("click", function () { go(i - 1); });
      next.addEventListener("click", function () { go(i + 1); });
      dots.forEach(function (d) {
        d.addEventListener("click", function () { go(parseInt(d.getAttribute("data-deck-dot"), 10)); });
      });
      var startX = null;
      viewport.addEventListener("touchstart", function (e) {
        startX = e.touches[0].clientX;
      }, { passive: true });
      viewport.addEventListener("touchend", function (e) {
        if (startX === null) return;
        var dx = e.changedTouches[0].clientX - startX;
        if (dx < -40) go(i + 1);
        else if (dx > 40) go(i - 1);
        startX = null;
      }, { passive: true });
    });
  })();
</script>
