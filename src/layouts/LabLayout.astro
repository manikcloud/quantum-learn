---
// LabLayout — the labs section's own visual identity: a dark "lab notebook"
// theme, deliberately different from the lesson pages.
//
// Conventions for lab pages (used by future lab content):
//   <section class="lab-steps">            wrapper for numbered steps
//     <div class="step">                   one step; gets auto number + checkbox
//       <h3>Step title</h3>
//       <p>…instructions…</p>
//       <pre class="lab-code">…code…</pre>
//       <div class="checkpoint"><strong>✓ Checkpoint:</strong> what you should see</div>
//       <div class="stuck"><strong>Stuck?</strong> what to try</div>
//     </div>
//   </section>
//   <div class="lab-progress"><div data-lab-progress></div></div>   progress bar
//   <button class="lab-complete" data-lab-complete="lab-slug">…</button>  done toggle
// Step checkboxes persist in localStorage under qlh-lab-<labSlug>.
const {
  title = "Quantum Labs",
  description = "Hands-on quantum lab sessions — step-by-step experiments you run yourself.",
  prevUrl = "",
  nextUrl = "",
  lang = "en",
  altUrl = "",
  labSlug = "",
  noGate = false,
  noFooter = false,
} = Astro.props;

const isHi = lang === "hi";
const footerText = isHi
  ? "Zero से quantum तक — एक qubit, एक कदम।"
  : "Zero to quantum — one qubit at a time.";
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · {isHi ? "क्वांटम लैब्स" : "Quantum Labs"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <style>
/* ===== Jupyter notebook look: flat deep-blue canvas, markdown + code cells ===== */
      .lab-root {
        --lbg: #1b3054;
        --lpanel: #162a4d;
        --lcode: #14294b;
        --lborder: #55688f;
        --lline: #2e4268;
        --ltext: #e9eef9;
        --lbody: #d4ddf0;
        --lmuted: #a9b8d6;
        --lfaint: #7f90b3;
        --laccent: #7ee787;
        --laccent-strong: #3fb950;
        --lamber: #e3b341;
        --lpurple: #b294f9;
        margin: 0;
        background: var(--lbg);
        color: var(--ltext);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif;
        line-height: 1.7;
        min-height: 100vh;
      }
      .lab-root a { color: #8fc3ff; }

      /* slim notebook toolbar */
      .lab-topbar {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; gap: 10px;
        padding: 10px 18px;
        background: var(--lpanel);
        border-bottom: 1px solid var(--lline);
      }
      .lab-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ltext); }
      .lab-brand:hover { text-decoration: none; }
      .lab-mark {
        width: 30px; height: 30px; border-radius: 6px;
        display: inline-flex; align-items: center; justify-content: center;
        background: #22365f; border: 1px solid #3c537f; color: #cfe0ff;
        font-size: 15px; font-weight: 700;
      }
      .lab-brand b { font-size: 15px; }
      .lab-brand small { display: block; font-size: 10.5px; color: var(--lfaint); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
      .lab-spacer { flex: 1; }
      .lab-lang, .lab-home {
        font-size: 13px; font-weight: 600; text-decoration: none;
        border: 1px solid #3c537f; border-radius: 6px;
        padding: 6px 12px; color: var(--ltext); background: #1e3560; white-space: nowrap;
      }
      .lab-lang:hover, .lab-home:hover { border-color: #6f8cc4; color: #fff; text-decoration: none; }

      /* notebook body */
      .lab { max-width: 920px; margin: 0 auto; padding: 38px 24px 90px; }

      /* title block: big white heading + divider, like a notebook title cell */
      .lab-hero { border-bottom: 1px solid var(--lline); padding-bottom: 24px; margin-bottom: 8px; }
      .lab-hero .prompt { display: none; }
      .lab h1 { font-size: clamp(30px, 5vw, 44px); margin: 0 0 12px; line-height: 1.2; color: #fff; letter-spacing: -0.01em; font-weight: 700; }
      .lab .lede { font-size: 16.5px; color: var(--lmuted); max-width: 720px; }
      .lab-meta { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 14px; font-size: 13.5px; }
      .lab-chip { background: none; border: none; padding: 0; color: var(--lfaint); font-size: 13.5px; font-weight: 600; box-shadow: none; }
      .lab-chip + .lab-chip::before { content: "\00B7"; margin-right: 10px; color: #5a6f99; }

      /* section headings inside the notebook */
      .lab h2 { font-size: clamp(22px, 3.4vw, 30px); color: #fff; font-weight: 700; margin: 44px 0 14px; }

      /* progress: slim bar under the title block */
      .lab-progress { height: 6px; background: var(--lcode); border: 1px solid var(--lline); border-radius: 999px; overflow: hidden; margin: 24px 0 8px; }
      .lab-progress > div { height: 100%; width: 0; background: var(--laccent-strong); transition: width .35s ease; border-radius: 999px; }
      .lab-progress-label { font-size: 13px; color: var(--lfaint); }

      /* steps = notebook markdown cells: no cards, text flows on the canvas */
      .lab-steps { margin-top: 6px; }
      .step { position: relative; padding: 26px 0; border-bottom: 1px solid var(--lline); }
      .step:last-child { border-bottom: none; }
      .step .step-title, .step h3 { margin: 0 0 10px; font-size: 21px; color: #fff; font-weight: 700; padding-right: 118px; }
      .step p { margin: 0 0 12px; font-size: 15.5px; color: var(--lbody); }
      .step p:last-child { margin-bottom: 0; }
      .step ul, .step ol { color: var(--lbody); font-size: 15.5px; }

      /* "mark done" toggle: small toolbar-style pill, top-right of the cell */
      .step-check { position: absolute; top: 28px; right: 0; cursor: pointer; font-size: 12.5px; font-weight: 600; }
      .step-check input { display: none; }
      .step-check span { display: inline-block; color: var(--lfaint); border: 1px solid #3c537f; background: #1e3560; padding: 4px 12px; border-radius: 6px; transition: all .15s ease; }
      .step-check span::before { content: "\2610  "; }
      .step-check:hover span { border-color: #6f8cc4; color: #fff; }
      .step-check input:checked + span { background: rgba(63,185,80,.16); border-color: var(--laccent-strong); color: var(--laccent); }
      .step-check input:checked + span::before { content: "\2611  "; }
      .step.done .step-title { color: var(--lmuted); }

      /* challenge cells: subtle purple left rule */
      .step.challenge { border-left: 3px solid var(--lpurple); padding-left: 18px; }
      .step.challenge .step-title::before { content: "\26A1  "; }

      /* code cells: Jupyter input-cell look */
      .lab-code {
        position: relative;
        background: var(--lcode);
        border: 1px solid var(--lborder);
        border-radius: 8px;
        padding: 14px 16px 26px;
        margin: 16px 0;
        overflow-x: auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
        font-size: 13.5px; line-height: 1.7;
        color: #d6deeb;
        tab-size: 4;
      }
      .code-lang { position: absolute; bottom: 7px; right: 13px; font-size: 11px; color: var(--lfaint); font-family: ui-sans-serif, system-ui, sans-serif; }
      .copy-btn {
        position: absolute; top: 8px; right: 8px;
        display: inline-flex; align-items: center; gap: 6px;
        background: #22365f; border: 1px solid #3c537f; color: var(--lmuted);
        font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 6px;
        cursor: pointer; opacity: 0; transition: opacity .15s ease, border-color .15s ease;
      }
      .lab-code:hover .copy-btn, .lab-code:focus-within .copy-btn { opacity: 1; }
      .copy-btn:hover { border-color: #8fc3ff; color: #fff; }
      .copy-btn.ok { border-color: var(--laccent-strong); color: var(--laccent); opacity: 1; }
      .copy-btn svg { width: 13px; height: 13px; }

      /* syntax highlighting: match the reference screenshot */
      .tok-k { color: #f78c6c; }
      .tok-s { color: #c3e88d; }
      .tok-c { color: #63718f; font-style: italic; }
      .tok-n { color: #f78c6c; }
      .tok-f { color: #82aaff; }

      /* callouts: flat notebook admonitions */
      .checkpoint, .stuck { border-radius: 0 8px 8px 0; padding: 12px 16px; margin: 16px 0 4px; font-size: 14.5px; color: var(--lbody); }
      .checkpoint { border-left: 3px solid var(--laccent-strong); background: rgba(63,185,80,.08); }
      .checkpoint strong { color: var(--laccent); }
      .stuck { border-left: 3px solid var(--lamber); background: rgba(227,179,65,.08); }
      .stuck strong { color: var(--lamber); }
      .checkpoint code, .stuck code { background: rgba(255,255,255,.08); border-radius: 4px; padding: 1px 6px; font-size: 13px; color: var(--ltext); }

      /* complete button */
      .lab-complete {
        margin-top: 36px; width: 100%; padding: 15px;
        font-size: 15.5px; font-weight: 700;
        border-radius: 8px; border: 1px solid var(--laccent-strong);
        cursor: pointer; background: #1d5c33; color: #fff;
        transition: background .15s ease;
      }
      .lab-complete:hover { background: #25703f; }
      .lab-complete.is-done { background: #2ea043; border-color: #2ea043; color: #04120a; }

      /* labs index */
      .how-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 20px; }
      .how-card { background: var(--lpanel); border: 1px solid var(--lline); border-radius: 8px; padding: 16px; transition: border-color .15s ease; }
      .how-card:hover { border-color: var(--lborder); }
      .how-card .ic { font-size: 24px; display: block; margin-bottom: 8px; }
      .how-card h3 { margin: 0 0 6px; font-size: 15.5px; color: #fff; }
      .how-card p { margin: 0; font-size: 13.5px; color: var(--lmuted); }
      .lab-list { display: grid; gap: 12px; margin-top: 26px; }
      .lab-card { display: block; background: var(--lpanel); border: 1px solid var(--lline); border-radius: 8px; padding: 18px 20px; text-decoration: none; transition: border-color .15s ease; }
      a.lab-card:hover { border-color: var(--lborder); text-decoration: none; }
      .lab-num { display: inline-block; font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--laccent); margin-bottom: 8px; }
      .lab-card h2 { margin: 0 0 8px; font-size: 20px; color: #fff; }
      .lab-card p { margin: 0; font-size: 14.5px; color: var(--lmuted); }
      .lab-card.soon { opacity: .75; }
      .soon-tag { display: inline-block; margin-left: 8px; font-size: 11.5px; font-weight: 700; color: var(--lamber); border: 1px solid var(--lamber); border-radius: 999px; padding: 2px 10px; vertical-align: middle; }

      /* footer */
      .lab-foot { margin-top: 64px; padding-top: 20px; border-top: 1px solid var(--lline); color: var(--lfaint); font-size: 13px; text-align: center; }

      /* confetti */
      .confetti-bit { position: fixed; top: -12px; width: 8px; height: 12px; z-index: 200; pointer-events: none; animation: confetti-fall 2.4s ease-in forwards; }
      @keyframes confetti-fall { to { transform: translateY(72vh) rotate(720deg); opacity: 0; } }

      /* auth gate */
      #auth-gate { position: fixed; inset: 0; z-index: 100; background: var(--lbg); display: flex; align-items: center; justify-content: center; }
      #auth-gate .gate-card { text-align: center; color: var(--lmuted); }
      #auth-gate .spinner { width: 36px; height: 36px; margin: 0 auto 14px; border-radius: 50%; border: 3px solid var(--lline); border-top-color: #8fc3ff; animation: labspin 0.9s linear infinite; }
      @keyframes labspin { to { transform: rotate(360deg); } }

      @media (max-width: 640px) {
        .lab { padding: 28px 16px 70px; }
        .step .step-title, .step h3 { padding-right: 0; }
        .step-check { position: static; display: block; margin-top: 14px; }
        .lab-code { font-size: 12.5px; padding: 12px 12px 24px; }
      }
    </style>
  </head>
  <body class="lab-root" data-lab={labSlug || undefined} data-prev={prevUrl || undefined} data-next={nextUrl || undefined} data-nogate={noGate ? "1" : undefined}>
    {!noGate && (
      <div id="auth-gate" aria-hidden="true">
        <div class="gate-card">
          <div class="spinner"></div>
          <p class="gate-msg">{isHi ? "साइन-इन जाँचा जा रहा है…" : "Checking sign-in…"}</p>
        </div>
      </div>
    )}
    <header class="lab-topbar">
      <a class="lab-brand" href={isHi ? "/hi/labs/" : "/labs/"}>
        <span class="lab-mark">⚗</span>
        <span><b>{isHi ? "क्वांटम लैब्स" : "Quantum Labs"}</b><small>{isHi ? "करके सीखें" : "learn by doing"}</small></span>
      </a>
      <span class="lab-spacer"></span>
      {altUrl && <a class="lab-lang" href={altUrl}>{isHi ? "EN" : "हिंदी"}</a>}
      <a class="lab-home" href={isHi ? "/hi/" : "/"}>{isHi ? "← सभी पाठ" : "← All lessons"}</a>
    </header>

    <main class="lab" data-pagefind-body>
      <span data-pagefind-filter="lang" hidden>{lang}</span>
      <slot />
      {!noFooter && <footer class="lab-foot">{footerText}</footer>}
    </main>

    <script>
      (function () {
        var HI = document.documentElement.lang === "hi";
        var slug = document.body.getAttribute("data-lab") || "";

        /* step checkboxes — persist per lab */
        function stepKey() { return "qlh-lab-" + slug; }
        function loadSteps() {
          try { return JSON.parse(localStorage.getItem(stepKey()) || "[]"); } catch (e) { return []; }
        }
        function saveSteps(list) {
          try { localStorage.setItem(stepKey(), JSON.stringify(list)); } catch (e) {}
        }
        var boxes = Array.prototype.slice.call(document.querySelectorAll(".step input[type='checkbox']"));
        var bar = document.querySelector("[data-lab-progress]");
        var barLabel = document.querySelector("[data-lab-progress-label]");
        function paintSteps() {
          var done = loadSteps();
          boxes.forEach(function (box, i) {
            var on = done.indexOf(i) !== -1;
            box.checked = on;
            var step = box.closest(".step");
            if (step) step.classList.toggle("done", on);
          });
          var n = boxes.filter(function (b) { return b.checked; }).length;
          if (bar) bar.style.width = (boxes.length ? Math.round((n / boxes.length) * 100) : 0) + "%";
          if (barLabel) barLabel.textContent = HI
            ? (boxes.length + " में से " + n + " steps पूरे")
            : (n + " of " + boxes.length + " steps done");
        }
        boxes.forEach(function (box, i) {
          box.addEventListener("change", function () {
            var done = loadSteps();
            var at = done.indexOf(i);
            if (box.checked && at === -1) done.push(i);
            if (!box.checked && at !== -1) done.splice(at, 1);
            saveSteps(done); paintSteps();
          });
        });
        paintSteps();

        /* code blocks: python highlighting + copy button, GitHub-readme style */
        function highlightPython(code) {
          var esc = code.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
          var re = /(#[^\n]*)|("""[\s\S]*?"""|'''[\s\S]*?'''|f"(?:\\.|[^"\\])*"|f'(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')|\b(import|from|as|def|return|for|in|if|else|elif|while|with|print|True|False|None|and|or|not|class|try|except|lambda|pass|break|continue|raise|assert|yield)\b|(\b\d[\d._]*(?:[eE][+-]?\d+)?j?\b)|([A-Za-z_]\w*)(?=\s*\()/g;
          return esc.replace(re, function (m, com, str, kw, num, fn) {
            if (com) return '<span class="tok-c">' + com + "</span>";
            if (str) return '<span class="tok-s">' + str + "</span>";
            if (kw) return '<span class="tok-k">' + kw + "</span>";
            if (num) return '<span class="tok-n">' + num + "</span>";
            if (fn) return '<span class="tok-f">' + fn + "</span>";
            return m;
          });
        }
        function enhanceLabCode() {
          Array.prototype.forEach.call(document.querySelectorAll(".lab-code"), function (pre) {
            if (!pre.dataset.hl) {
              pre.dataset.code = pre.textContent;
              pre.innerHTML = highlightPython(pre.textContent);
              pre.dataset.hl = "1";
            }
            var lang = document.createElement("span");
            lang.className = "code-lang";
            lang.textContent = pre.dataset.lang || "python";
            pre.appendChild(lang);
            var btn = document.createElement("button");
            btn.className = "copy-btn";
            btn.type = "button";
            btn.setAttribute("aria-label", HI ? "कोड कॉपी करें" : "Copy code");
            btn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="4" width="9" height="10" rx="2"/><path d="M11 4V3a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v1"/></svg><span>copy</span>';
            btn.addEventListener("click", function () {
              var label = btn.querySelector("span");
              function done(ok) {
                btn.classList.toggle("ok", ok);
                label.textContent = ok ? (HI ? "कॉपी हो गया" : "copied") : "failed";
                setTimeout(function () { btn.classList.remove("ok"); label.textContent = "copy"; }, 1600);
              }
              var text = pre.dataset.code || pre.textContent;
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });
              } else {
                var ta = document.createElement("textarea");
                ta.value = text; document.body.appendChild(ta); ta.select();
                try { done(document.execCommand("copy")); } catch (e) { done(false); }
                ta.remove();
              }
            });
            pre.appendChild(btn);
          });
        }
        enhanceLabCode();

        /* mark lab complete */
        function labsDone() {
          try { return JSON.parse(localStorage.getItem("qlh-labs-done") || "[]"); } catch (e) { return []; }
        }
        var completeBtn = document.querySelector("[data-lab-complete]");
        function syncComplete() {
          if (!completeBtn || !slug) return;
          var id = completeBtn.getAttribute("data-lab-complete");
          var done = labsDone().indexOf(id) !== -1;
          completeBtn.textContent = done
            ? (HI ? "✓ लैब पूर्ण — वापस लेने के लिए क्लिक करें" : "✓ Lab complete — click to undo")
            : (HI ? "लैब पूर्ण चिह्नित करें" : "Mark lab as complete");
          completeBtn.classList.toggle("is-done", done);
        }
        if (completeBtn) completeBtn.addEventListener("click", function () {
          var id = completeBtn.getAttribute("data-lab-complete");
          var done = labsDone();
          var at = done.indexOf(id);
          if (at === -1) {
            done.push(id);
            confetti();
          } else done.splice(at, 1);
          try { localStorage.setItem("qlh-labs-done", JSON.stringify(done)); } catch (e) {}
          syncComplete();
        });
        syncComplete();

        /* confetti burst when a lab is completed */
        function confetti() {
          var colors = ["#3fb950", "#58a6ff", "#d29922", "#a371f7", "#f778ba", "#7ee787"];
          for (var i = 0; i < 60; i++) {
            var p = document.createElement("i");
            p.className = "confetti-bit";
            p.style.left = (38 + Math.random() * 24) + "%";
            p.style.background = colors[i % colors.length];
            p.style.animationDelay = (Math.random() * 0.3) + "s";
            document.body.appendChild(p);
            (function (el) { setTimeout(function () { el.remove(); }, 3000); })(p);
          }
        }

        /* math rendering */
        function renderMath() {
          if (window.renderMathInElement) {
            renderMathInElement(document.body, {
              delimiters: [
                { left: "$$", right: "$$", display: true },
                { left: "\\(", right: "\\)", display: false },
                { left: "\\[", right: "\\]", display: true },
              ],
              throwOnError: false,
            });
          }
        }
        if (document.readyState === "complete") renderMath();
        else window.addEventListener("load", renderMath);
      })();
    </script>
    {/* Same site-wide login wall contract as SiteLayout (see public/auth/README.md). */}
    <script>
      (function () {
        if (document.body && document.body.dataset.nogate === "1") return;
        var AUTH_BASE = "/auth/";
        var gate = document.getElementById("auth-gate");
        var HI = document.documentElement.lang === "hi";
        function hideGate() { if (gate) gate.style.display = "none"; }
        function gateMsg(t) { var m = gate && gate.querySelector(".gate-msg"); if (m) m.textContent = t; }
        function unreachable() {
          gateMsg(HI
            ? "साइन-इन सेवा नहीं मिल रही — कनेक्शन जाँचें और पेज reload करें।"
            : "Sign-in service unreachable — check your connection and reload.");
        }
        function loginUrl(denied, unverified) {
          var base = HI ? "/hi/login/" : "/login/";
          var next = encodeURIComponent(window.location.pathname + window.location.search);
          return base + "?next=" + next + (denied ? "&denied=1" : "") + (unverified ? "&unverified=1" : "");
        }
        import(/* @vite-ignore */ AUTH_BASE + "config.js").then(function () {
          return import(/* @vite-ignore */ AUTH_BASE + "index.js");
        }).then(function (mod) {
          var auth = mod.auth;
          if (!auth.configured) { hideGate(); return; }
          var settled = false;
          auth.ready.catch(unreachable);
          auth.onAuthChange(function (user, info) {
            if (info && info.denied) { window.location.replace(loginUrl(true, false)); return; }
            if (info && info.unverified) { window.location.replace(loginUrl(false, true)); return; }
            if (!user) { window.location.replace(loginUrl(false, false)); return; }
            settled = true;
            hideGate();
          }).catch(unreachable);
          setTimeout(function () {
            if (!settled && gate && gate.style.display !== "none") {
              gateMsg(HI
                ? "साइन-इन में देर हो रही है — पेज reload करें।"
                : "Sign-in is taking too long — reload the page.");
            }
          }, 20000);
        }).catch(unreachable);
      })();
    </script>
  </body>
</html>
