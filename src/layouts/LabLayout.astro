---
// LabLayout — the labs section's own visual identity: a dark "lab notebook"
// theme, deliberately different from the lesson pages.
//
// Conventions for lab pages (used by future lab content):
//   <section class="lab-steps">            wrapper for numbered steps
//     <div class="step">                   one step; gets auto number + checkbox
//       <h3>Step title</h3>
//       <p>…instructions…</p>
//       <pre class="lab-code">…code…</pre>
//       <div class="checkpoint"><strong>✓ Checkpoint:</strong> what you should see</div>
//       <div class="stuck"><strong>Stuck?</strong> what to try</div>
//     </div>
//   </section>
//   <div class="lab-progress"><div data-lab-progress></div></div>   progress bar
//   <button class="lab-complete" data-lab-complete="lab-slug">…</button>  done toggle
// Step checkboxes persist in localStorage under qlh-lab-<labSlug>.
const {
  title = "Quantum Labs",
  description = "Hands-on quantum lab sessions — step-by-step experiments you run yourself.",
  prevUrl = "",
  nextUrl = "",
  lang = "en",
  altUrl = "",
  labSlug = "",
  noGate = false,
  noFooter = false,
} = Astro.props;

const isHi = lang === "hi";
const footerText = isHi
  ? "Zero से quantum तक — एक qubit, एक कदम।"
  : "Zero to quantum — one qubit at a time.";
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · {isHi ? "क्वांटम लैब्स" : "Quantum Labs"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <style>
      .lab-root {
        --lbg: #172c50;
        --lbg2: #101f3a;
        --lcard: #1a3055;
        --lborder: #2f4c78;
        --ltext: #eaf1fb;
        --lmuted: #a9bcd6;
        --lfaint: #7e93b5;
        --laccent: #3fb950;
        --laccent-hi: #7ee787;
        --laccent-dim: #1a3a24;
        --lamber: #d29922;
        --lpurple: #a371f7;
        --lcode: #0f1e39;
        --lradius: 14px;
        margin: 0;
        background: var(--lbg);
        color: var(--ltext);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif;
        line-height: 1.65;
        min-height: 100vh;
        overflow-x: hidden;
      }
      .lab-root a { color: #58a6ff; }
      /* ambient backdrop: glows + blueprint grid */
      .lab-root::before {
        content: ""; position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background:
          radial-gradient(640px 420px at 12% -4%, rgba(63,185,80,.10), transparent 62%),
          radial-gradient(720px 520px at 94% 108%, rgba(88,166,255,.18), transparent 60%),
          radial-gradient(520px 420px at 84% 6%, rgba(163,113,247,.10), transparent 60%);
      }
      .lab-root::after {
        content: ""; position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background-image:
          linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px);
        background-size: 44px 44px;
        -webkit-mask-image: radial-gradient(ellipse 90% 62% at 50% 0%, black 25%, transparent 78%);
        mask-image: radial-gradient(ellipse 90% 62% at 50% 0%, black 25%, transparent 78%);
      }
      .lab-topbar, .lab { position: relative; z-index: 1; }
      /* top bar */
      .lab-topbar {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; gap: 12px;
        padding: 12px 20px;
        background: rgba(18, 32, 60, 0.88);
        border-bottom: 1px solid var(--lborder);
        box-shadow: 0 6px 28px rgba(0,0,0,.55);
        backdrop-filter: blur(10px);
      }
      .lab-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ltext); }
      .lab-brand:hover { text-decoration: none; }
      .lab-mark {
        width: 36px; height: 36px; border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #14401f, #0b2417);
        border: 1px solid #2c6e42; color: var(--laccent-hi);
        font-weight: 800; font-size: 19px;
        box-shadow: 0 0 18px rgba(63,185,80,.45);
      }
      .lab-brand b { font-size: 16px; letter-spacing: -0.01em; }
      .lab-brand small { display: block; font-size: 11px; color: var(--lfaint); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
      .lab-spacer { flex: 1; }
      .lab-lang, .lab-home {
        font-size: 13.5px; font-weight: 700; text-decoration: none;
        border: 1px solid var(--lborder); border-radius: 10px;
        padding: 8px 14px; color: var(--ltext); background: rgba(22,40,72,.8);
        transition: border-color .15s ease, box-shadow .15s ease;
      }
      .lab-lang:hover, .lab-home:hover { border-color: var(--laccent); box-shadow: 0 0 14px rgba(63,185,80,.25); text-decoration: none; color: var(--ltext); }
      /* main */
      .lab { max-width: 880px; margin: 0 auto; padding: 40px 22px 90px; }
      .lab-hero { position: relative; }
      .lab-hero .prompt {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color: var(--laccent-hi); font-size: 14px; margin-bottom: 14px;
        background: rgba(63,185,80,.08); border: 1px solid rgba(63,185,80,.4);
        padding: 8px 14px; border-radius: 9px;
        box-shadow: 0 0 24px rgba(63,185,80,.15);
      }
      .lab-hero .prompt::before { content: "$ "; opacity: .7; }
      .lab-hero .prompt::after { content: "▍"; animation: labblink 1.1s steps(1) infinite; margin-left: 2px; }
      @keyframes labblink { 50% { opacity: 0; } }
      .lab h1 {
        font-size: clamp(32px, 5.4vw, 48px); letter-spacing: -0.025em; margin: 0 0 14px; line-height: 1.12;
        background: linear-gradient(180deg, #ffffff 25%, #8fe39a 95%);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent; color: transparent;
      }
      .lab h2 { font-size: 23px; margin: 48px 0 14px; letter-spacing: -0.01em; }
      .lab h2::before { content: "## "; color: var(--lfaint); font-weight: 400; }
      .lab .lede { font-size: 18px; color: var(--lmuted); max-width: 660px; }
      .lab-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
      .lab-chip {
        font-size: 12.5px; font-weight: 700; color: var(--laccent-hi);
        background: rgba(63,185,80,.1); border: 1px solid rgba(63,185,80,.45);
        border-radius: 999px; padding: 6px 14px;
        box-shadow: 0 0 16px rgba(63,185,80,.12);
      }
      /* how-it-works cards */
      .how-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-top: 20px; }
      .how-card {
        background: linear-gradient(180deg, rgba(30,54,92,.92), rgba(17,32,60,.92));
        border: 1px solid var(--lborder); border-radius: var(--lradius); padding: 18px;
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
      }
      .how-card:hover { transform: translateY(-3px); border-color: rgba(63,185,80,.5); box-shadow: 0 14px 36px rgba(0,0,0,.5), 0 0 24px rgba(63,185,80,.1); }
      .how-card .ic { font-size: 24px; filter: drop-shadow(0 0 8px rgba(63,185,80,.4)); }
      .how-card h3 { margin: 10px 0 4px; font-size: 15px; }
      .how-card p { margin: 0; font-size: 13.5px; color: var(--lmuted); }
      /* lab list */
      .lab-list { display: grid; gap: 16px; margin-top: 20px; }
      a.lab-card {
        display: block; color: var(--ltext); text-decoration: none;
        background: linear-gradient(180deg, rgba(30,54,92,.95), rgba(17,32,60,.95));
        border: 1px solid var(--lborder);
        border-radius: var(--lradius); padding: 22px 24px;
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
        position: relative; overflow: hidden;
      }
      a.lab-card::after {
        content: ""; position: absolute; inset: 0 0 auto 0; height: 3px;
        background: linear-gradient(90deg, var(--laccent), #58a6ff, var(--lpurple));
        opacity: 0; transition: opacity .16s ease;
      }
      a.lab-card:hover { transform: translateY(-3px); border-color: rgba(63,185,80,.55); box-shadow: 0 16px 44px rgba(0,0,0,.55), 0 0 30px rgba(63,185,80,.12); text-decoration: none; }
      a.lab-card:hover::after { opacity: 1; }
      .lab-card.soon { border-style: dashed; opacity: 0.9; }
      .lab-num { font-size: 12px; font-weight: 800; letter-spacing: 0.12em; color: var(--laccent-hi); text-transform: uppercase; }
      .lab-card h3 { margin: 10px 0 6px; font-size: 21px; letter-spacing: -0.01em; }
      .lab-card p { margin: 0; font-size: 14.5px; color: var(--lmuted); }
      .soon-tag {
        display: inline-block; margin-top: 14px; font-size: 12px; font-weight: 700;
        color: var(--lamber); border: 1px dashed var(--lamber); border-radius: 999px; padding: 5px 14px;
      }
      /* steps — mission timeline */
      .lab-steps { counter-reset: step; display: grid; gap: 16px; margin-top: 24px; position: relative; }
      .lab-steps::before {
        content: ""; position: absolute; left: 35px; top: 26px; bottom: 26px; width: 2px;
        background: linear-gradient(180deg, rgba(63,185,80,.55), rgba(63,185,80,.06));
      }
      .step {
        position: relative;
        background: linear-gradient(180deg, rgba(30,54,92,.94), rgba(17,32,60,.94));
        border: 1px solid var(--lborder);
        border-radius: var(--lradius); padding: 20px 22px 20px 70px;
        box-shadow: 0 10px 34px rgba(0,0,0,.5);
        transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
        animation: labrise .5s ease both;
      }
      .lab-steps .step:nth-child(2) { animation-delay: .05s; }
      .lab-steps .step:nth-child(3) { animation-delay: .1s; }
      .lab-steps .step:nth-child(4) { animation-delay: .15s; }
      .lab-steps .step:nth-child(5) { animation-delay: .2s; }
      .lab-steps .step:nth-child(6) { animation-delay: .25s; }
      @keyframes labrise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
      .step:hover { border-color: #3a5a8c; }
      .step::before {
        counter-increment: step; content: counter(step);
        position: absolute; left: 19px; top: 20px; z-index: 1;
        width: 34px; height: 34px; border-radius: 50%;
        background: #101f3a; border: 1px solid #3a5a8c;
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 14px; color: var(--lmuted);
        box-shadow: 0 0 0 5px var(--lbg), 0 0 18px rgba(63,185,80,.28);
        transition: all .2s ease;
      }
      .step.done { border-color: rgba(63,185,80,.55); box-shadow: 0 10px 34px rgba(0,0,0,.5), 0 0 26px rgba(63,185,80,.1); }
      .step.done::before { background: var(--laccent-dim); border-color: var(--laccent); color: var(--laccent-hi); box-shadow: 0 0 0 5px var(--lbg), 0 0 20px rgba(63,185,80,.6); }
      .step.done .step-title { color: var(--lmuted); }
      /* challenge steps — "your turn" */
      .step.challenge { border-color: rgba(163,113,247,.5); background: linear-gradient(180deg, rgba(40,32,72,.94), rgba(17,32,60,.94)); }
      .step.challenge::before { border-color: var(--lpurple); color: #c9a6ff; box-shadow: 0 0 0 5px var(--lbg), 0 0 20px rgba(163,113,247,.55); }
      .step.challenge .step-title::before { content: "⚡ "; }
      .step-check {
        position: absolute; left: 14px; top: 62px; z-index: 1;
        cursor: pointer; font-size: 12px; font-weight: 700;
      }
      .step-check input { display: none; }
      .step-check span {
        display: inline-block; color: var(--lfaint);
        border: 1px solid #3a5a8c; background: rgba(18,32,60,.92);
        padding: 5px 13px; border-radius: 999px;
        transition: all .18s ease; white-space: nowrap;
      }
      .step-check span::before { content: "○  "; }
      .step-check:hover span { border-color: var(--laccent); color: var(--ltext); }
      .step-check input:checked + span { background: rgba(63,185,80,.16); border-color: var(--laccent); color: var(--laccent-hi); box-shadow: 0 0 14px rgba(63,185,80,.3); }
      .step-check input:checked + span::before { content: "●  "; }
      .step h3 { margin: 0 0 8px; font-size: 18px; letter-spacing: -0.01em; }
      .step p { margin: 0 0 10px; font-size: 15px; color: var(--lmuted); }
      .step p:last-child { margin-bottom: 0; }
      /* code windows */
      .lab-code {
        position: relative;
        background: var(--lcode); border: 1px solid #33507f; border-radius: 10px;
        padding: 44px 16px 14px; margin: 12px 0; overflow-x: auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 13.5px; line-height: 1.65; color: #cfdaec;
        box-shadow: 0 8px 28px rgba(0,0,0,.55), inset 0 0 40px rgba(88,166,255,.03);
      }
      .lab-code::before {
        content: ""; position: absolute; top: 0; left: 0; right: 0; height: 30px;
        background: #0d1b33; border-bottom: 1px solid #2a4570; border-radius: 10px 10px 0 0;
      }
      .lab-code::after {
        content: "●●●"; position: absolute; top: 9px; left: 14px; z-index: 1;
        color: #ff5f57; font-size: 10px; letter-spacing: 2px;
        text-shadow: 15px 0 #febc2e, 30px 0 #28c840;
      }
      .lab-code .code-lang {
        position: absolute; top: 8px; left: 66px; z-index: 1;
        font-size: 10.5px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--lfaint);
      }
      .copy-btn {
        position: absolute; top: 4px; right: 10px; z-index: 2;
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(88,166,255,.07); border: 1px solid #3a5a8c; color: #a9bcd6;
        font-size: 12px; font-weight: 700; padding: 3px 11px; border-radius: 7px; cursor: pointer;
        transition: all .15s ease; font-family: inherit;
      }
      .copy-btn:hover { border-color: #58a6ff; color: #fff; background: rgba(88,166,255,.16); }
      .copy-btn.ok { border-color: var(--laccent); color: var(--laccent-hi); }
      .copy-btn svg { width: 13px; height: 13px; }
      /* syntax highlighting (GitHub-dark flavored) */
      .lab-code { border: 1px solid #3a5a8c; }
      .tok-k { color: #ff7b72; }
      .tok-s { color: #a5d6ff; }
      .tok-c { color: #8b949e; font-style: italic; }
      .tok-n { color: #79c0ff; }
      .tok-f { color: #d2a8ff; }
      /* checkpoint + stuck callouts */
      .checkpoint {
        border: 1px solid rgba(63,185,80,.45); background: rgba(63,185,80,.07);
        border-radius: 10px; padding: 13px 15px; margin: 13px 0 4px; font-size: 14px;
        box-shadow: 0 0 22px rgba(63,185,80,.09), inset 0 0 24px rgba(63,185,80,.04);
      }
      .checkpoint strong { color: var(--laccent-hi); }
      .checkpoint code, .stuck code {
        background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
        border-radius: 5px; padding: 1px 6px; font-size: 13px;
      }
      .stuck {
        border: 1px solid rgba(210,153,34,.45); background: rgba(210,153,34,.07);
        border-radius: 10px; padding: 13px 15px; margin: 13px 0 4px; font-size: 14px;
        box-shadow: 0 0 22px rgba(210,153,34,.08);
      }
      .stuck strong { color: var(--lamber); }
      /* progress */
      .lab-progress { height: 10px; background: #101f3a; border: 1px solid var(--lborder); border-radius: 999px; overflow: hidden; margin: 28px 0 8px; box-shadow: inset 0 2px 6px rgba(0,0,0,.6); }
      .lab-progress > div { height: 100%; width: 0; background: linear-gradient(90deg, #2ea043, var(--laccent-hi)); box-shadow: 0 0 14px rgba(63,185,80,.8); transition: width 0.35s ease; border-radius: 999px; }
      .lab-progress-label { font-size: 13px; color: var(--lfaint); font-weight: 600; }
      .lab-complete {
        margin-top: 28px; width: 100%; padding: 17px; font-size: 16px; font-weight: 800;
        border-radius: 12px; border: 1px solid rgba(63,185,80,.6); cursor: pointer;
        background: linear-gradient(135deg, #1f6f38, #2ea043); color: #fff;
        box-shadow: 0 8px 30px rgba(63,185,80,.35);
        transition: transform .15s ease, box-shadow .15s ease;
      }
      .lab-complete:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(63,185,80,.5); }
      .lab-complete.is-done {
        background: linear-gradient(135deg, #2ea043, var(--laccent-hi)); color: #04120a; border-color: transparent;
        box-shadow: 0 8px 34px rgba(126,231,135,.4);
      }
      .lab-foot {
        margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--lborder);
        color: var(--lfaint); font-size: 13px; text-align: center;
      }
      /* confetti */
      .confetti-bit { position: fixed; top: 42%; width: 9px; height: 14px; z-index: 200; pointer-events: none; border-radius: 2px; animation: confetti-fall 2.3s ease-in forwards; }
      @keyframes confetti-fall { to { transform: translateY(72vh) rotate(720deg); opacity: 0; } }
      /* auth gate */
      #auth-gate {
        position: fixed; inset: 0; z-index: 100;
        background: var(--lbg); display: flex; align-items: center; justify-content: center;
      }
      #auth-gate .gate-card { text-align: center; color: var(--lmuted); }
      #auth-gate .spinner {
        width: 36px; height: 36px; margin: 0 auto 14px; border-radius: 50%;
        border: 3px solid var(--lborder); border-top-color: var(--laccent);
        box-shadow: 0 0 18px rgba(63,185,80,.35);
        animation: labspin 0.9s linear infinite;
      }
      @keyframes labspin { to { transform: rotate(360deg); } }
      @media (max-width: 640px) {
        .lab { padding: 28px 16px 70px; }
        .lab-steps::before { left: 29px; }
        .step { padding-left: 58px; }
        .step::before { left: 13px; }
        .step-check { left: 8px; }
      }
    </style>
  </head>
  <body class="lab-root" data-lab={labSlug || undefined} data-prev={prevUrl || undefined} data-next={nextUrl || undefined} data-nogate={noGate ? "1" : undefined}>
    {!noGate && (
      <div id="auth-gate" aria-hidden="true">
        <div class="gate-card">
          <div class="spinner"></div>
          <p class="gate-msg">{isHi ? "साइन-इन जाँचा जा रहा है…" : "Checking sign-in…"}</p>
        </div>
      </div>
    )}
    <header class="lab-topbar">
      <a class="lab-brand" href={isHi ? "/hi/labs/" : "/labs/"}>
        <span class="lab-mark">⚗</span>
        <span><b>{isHi ? "क्वांटम लैब्स" : "Quantum Labs"}</b><small>{isHi ? "करके सीखें" : "learn by doing"}</small></span>
      </a>
      <span class="lab-spacer"></span>
      {altUrl && <a class="lab-lang" href={altUrl}>{isHi ? "EN" : "हिंदी"}</a>}
      <a class="lab-home" href={isHi ? "/hi/" : "/"}>{isHi ? "← सभी पाठ" : "← All lessons"}</a>
    </header>

    <main class="lab" data-pagefind-body>
      <span data-pagefind-filter="lang" hidden>{lang}</span>
      <slot />
      {!noFooter && <footer class="lab-foot">{footerText}</footer>}
    </main>

    <script>
      (function () {
        var HI = document.documentElement.lang === "hi";
        var slug = document.body.getAttribute("data-lab") || "";

        /* step checkboxes — persist per lab */
        function stepKey() { return "qlh-lab-" + slug; }
        function loadSteps() {
          try { return JSON.parse(localStorage.getItem(stepKey()) || "[]"); } catch (e) { return []; }
        }
        function saveSteps(list) {
          try { localStorage.setItem(stepKey(), JSON.stringify(list)); } catch (e) {}
        }
        var boxes = Array.prototype.slice.call(document.querySelectorAll(".step input[type='checkbox']"));
        var bar = document.querySelector("[data-lab-progress]");
        var barLabel = document.querySelector("[data-lab-progress-label]");
        function paintSteps() {
          var done = loadSteps();
          boxes.forEach(function (box, i) {
            var on = done.indexOf(i) !== -1;
            box.checked = on;
            var step = box.closest(".step");
            if (step) step.classList.toggle("done", on);
          });
          var n = boxes.filter(function (b) { return b.checked; }).length;
          if (bar) bar.style.width = (boxes.length ? Math.round((n / boxes.length) * 100) : 0) + "%";
          if (barLabel) barLabel.textContent = HI
            ? (boxes.length + " में से " + n + " steps पूरे")
            : (n + " of " + boxes.length + " steps done");
        }
        boxes.forEach(function (box, i) {
          box.addEventListener("change", function () {
            var done = loadSteps();
            var at = done.indexOf(i);
            if (box.checked && at === -1) done.push(i);
            if (!box.checked && at !== -1) done.splice(at, 1);
            saveSteps(done); paintSteps();
          });
        });
        paintSteps();

        /* code blocks: python highlighting + copy button, GitHub-readme style */
        function highlightPython(code) {
          var esc = code.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
          var re = /(#[^\n]*)|("""[\s\S]*?"""|'''[\s\S]*?'''|f"(?:\\.|[^"\\])*"|f'(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')|\b(import|from|as|def|return|for|in|if|else|elif|while|with|print|True|False|None|and|or|not|class|try|except|lambda|pass|break|continue|raise|assert|yield)\b|(\b\d[\d._]*(?:[eE][+-]?\d+)?j?\b)|([A-Za-z_]\w*)(?=\s*\()/g;
          return esc.replace(re, function (m, com, str, kw, num, fn) {
            if (com) return '<span class="tok-c">' + com + "</span>";
            if (str) return '<span class="tok-s">' + str + "</span>";
            if (kw) return '<span class="tok-k">' + kw + "</span>";
            if (num) return '<span class="tok-n">' + num + "</span>";
            if (fn) return '<span class="tok-f">' + fn + "</span>";
            return m;
          });
        }
        function enhanceLabCode() {
          Array.prototype.forEach.call(document.querySelectorAll(".lab-code"), function (pre) {
            if (!pre.dataset.hl) {
              pre.innerHTML = highlightPython(pre.textContent);
              pre.dataset.hl = "1";
            }
            var lang = document.createElement("span");
            lang.className = "code-lang";
            lang.textContent = pre.dataset.lang || "python";
            pre.appendChild(lang);
            var btn = document.createElement("button");
            btn.className = "copy-btn";
            btn.type = "button";
            btn.setAttribute("aria-label", HI ? "कोड कॉपी करें" : "Copy code");
            btn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="4" width="9" height="10" rx="2"/><path d="M11 4V3a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v1"/></svg><span>copy</span>';
            btn.addEventListener("click", function () {
              var label = btn.querySelector("span");
              function done(ok) {
                btn.classList.toggle("ok", ok);
                label.textContent = ok ? (HI ? "कॉपी हो गया" : "copied") : "failed";
                setTimeout(function () { btn.classList.remove("ok"); label.textContent = "copy"; }, 1600);
              }
              var text = pre.innerText;
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });
              } else {
                var ta = document.createElement("textarea");
                ta.value = text; document.body.appendChild(ta); ta.select();
                try { done(document.execCommand("copy")); } catch (e) { done(false); }
                ta.remove();
              }
            });
            pre.appendChild(btn);
          });
        }
        enhanceLabCode();

        /* mark lab complete */
        function labsDone() {
          try { return JSON.parse(localStorage.getItem("qlh-labs-done") || "[]"); } catch (e) { return []; }
        }
        var completeBtn = document.querySelector("[data-lab-complete]");
        function syncComplete() {
          if (!completeBtn || !slug) return;
          var id = completeBtn.getAttribute("data-lab-complete");
          var done = labsDone().indexOf(id) !== -1;
          completeBtn.textContent = done
            ? (HI ? "✓ लैब पूर्ण — वापस लेने के लिए क्लिक करें" : "✓ Lab complete — click to undo")
            : (HI ? "लैब पूर्ण चिह्नित करें" : "Mark lab as complete");
          completeBtn.classList.toggle("is-done", done);
        }
        if (completeBtn) completeBtn.addEventListener("click", function () {
          var id = completeBtn.getAttribute("data-lab-complete");
          var done = labsDone();
          var at = done.indexOf(id);
          if (at === -1) {
            done.push(id);
            confetti();
          } else done.splice(at, 1);
          try { localStorage.setItem("qlh-labs-done", JSON.stringify(done)); } catch (e) {}
          syncComplete();
        });
        syncComplete();

        /* confetti burst when a lab is completed */
        function confetti() {
          var colors = ["#3fb950", "#58a6ff", "#d29922", "#a371f7", "#f778ba", "#7ee787"];
          for (var i = 0; i < 60; i++) {
            var p = document.createElement("i");
            p.className = "confetti-bit";
            p.style.left = (38 + Math.random() * 24) + "%";
            p.style.background = colors[i % colors.length];
            p.style.animationDelay = (Math.random() * 0.3) + "s";
            document.body.appendChild(p);
            (function (el) { setTimeout(function () { el.remove(); }, 3000); })(p);
          }
        }

        /* math rendering */
        function renderMath() {
          if (window.renderMathInElement) {
            renderMathInElement(document.body, {
              delimiters: [
                { left: "$$", right: "$$", display: true },
                { left: "\\(", right: "\\)", display: false },
                { left: "\\[", right: "\\]", display: true },
              ],
              throwOnError: false,
            });
          }
        }
        if (document.readyState === "complete") renderMath();
        else window.addEventListener("load", renderMath);
      })();
    </script>
    {/* Same site-wide login wall contract as SiteLayout (see public/auth/README.md). */}
    <script>
      (function () {
        if (document.body && document.body.dataset.nogate === "1") return;
        var AUTH_BASE = "/auth/";
        var gate = document.getElementById("auth-gate");
        var HI = document.documentElement.lang === "hi";
        function hideGate() { if (gate) gate.style.display = "none"; }
        function gateMsg(t) { var m = gate && gate.querySelector(".gate-msg"); if (m) m.textContent = t; }
        function unreachable() {
          gateMsg(HI
            ? "साइन-इन सेवा नहीं मिल रही — कनेक्शन जाँचें और पेज reload करें।"
            : "Sign-in service unreachable — check your connection and reload.");
        }
        function loginUrl(denied, unverified) {
          var base = HI ? "/hi/login/" : "/login/";
          var next = encodeURIComponent(window.location.pathname + window.location.search);
          return base + "?next=" + next + (denied ? "&denied=1" : "") + (unverified ? "&unverified=1" : "");
        }
        import(/* @vite-ignore */ AUTH_BASE + "config.js").then(function () {
          return import(/* @vite-ignore */ AUTH_BASE + "index.js");
        }).then(function (mod) {
          var auth = mod.auth;
          if (!auth.configured) { hideGate(); return; }
          var settled = false;
          auth.ready.catch(unreachable);
          auth.onAuthChange(function (user, info) {
            if (info && info.denied) { window.location.replace(loginUrl(true, false)); return; }
            if (info && info.unverified) { window.location.replace(loginUrl(false, true)); return; }
            if (!user) { window.location.replace(loginUrl(false, false)); return; }
            settled = true;
            hideGate();
          }).catch(unreachable);
          setTimeout(function () {
            if (!settled && gate && gate.style.display !== "none") {
              gateMsg(HI
                ? "साइन-इन में देर हो रही है — पेज reload करें।"
                : "Sign-in is taking too long — reload the page.");
            }
          }, 20000);
        }).catch(unreachable);
      })();
    </script>
  </body>
</html>
