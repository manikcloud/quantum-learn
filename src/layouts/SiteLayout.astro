---
import "../styles/global.css";
import { modules, flatLessons, moduleOf } from "../data/curriculum.js";
import { t } from "../data/i18n.js";
import { hiModuleTitle, hiLessonTitle } from "../data/hi-meta.js";

const {
  title = "Quantum Learning Hub",
  description = "Plain-language study notes for quantum computing and quantum machine learning — from everyday intuition to the real math.",
  currentSlug = "",
  prevUrl = "",
  nextUrl = "",
  lang = "en",
  altUrl = "",
  noGate = false,
  noFooter = false,
} = Astro.props;

const isHi = lang === "hi";
const base = isHi ? "/hi" : "";
const searchNone = t(lang, "searchNone");
const lessonCount = flatLessons.length;
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · {isHi ? "क्वांटम लर्निंग हब" : "Quantum Learning Hub"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
  </head>
  <body data-prev={prevUrl || undefined} data-next={nextUrl || undefined} data-lesson-count={lessonCount} data-nogate={noGate ? "1" : undefined}>
    {!noGate && (
      <div id="auth-gate" aria-hidden="true">
        <div class="gate-card">
          <div class="spinner"></div>
          <p class="gate-msg">{isHi ? "साइन-इन जाँचा जा रहा है…" : "Checking sign-in…"}</p>
        </div>
      </div>
    )}
    <header class="topbar">
      <button class="icon-btn" id="menu-toggle" aria-label="Open navigation">☰</button>
      <a class="brand" href={isHi ? "/hi/" : "/"}>
        <span class="brand-mark">Q</span>
        <span>
          <span class="brand-name">{isHi ? "क्वांटम लर्निंग हब" : "Quantum Learning Hub"}</span><br />
          <span class="brand-sub">{t(lang, "brandSub")}</span>
        </span>
      </a>
      <span class="topbar-spacer"></span>
      <div class="search-wrap">
        <span class="search-icon">⌕</span>
        <input id="site-search" type="search" placeholder={t(lang, "searchPh")} data-none={searchNone} autocomplete="off" />
        <div id="search-results" hidden></div>
      </div>
      {altUrl && (
        <a class="lang-btn" href={altUrl} aria-label={isHi ? "Switch to English" : "हिंदी में पढ़ें"}>
          {isHi ? "EN" : "हिंदी"}
        </a>
      )}
      <span id="user-chip" class="user-chip" hidden></span>
      <button class="icon-btn" id="signout-btn" hidden title={t(lang, "signOut")} aria-label={t(lang, "signOut")}>⏻</button>
      <button class="icon-btn" id="theme-toggle" aria-label="Toggle light/dark mode">◐</button>
    </header>

    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <h3>{t(lang, "sidebarTitle")}</h3>
        {
          modules.map((m) => (
            <div class="mod-group">
              <a class="mod-head" href={`${base}/modules/${m.id}/`}>
                <span class="n">{m.number}</span>{isHi ? hiModuleTitle(m) : m.title}
              </a>
              <ul class="lesson-links">
                {m.lessons.map((l) => (
                  <li>
                    <a
                      href={`${base}/lessons/${l.slug}/`}
                      data-lesson-link={l.slug}
                      class={currentSlug === l.slug ? "active" : ""}
                    >{isHi ? hiLessonTitle(l) : l.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="mod-group">
          <span class="mod-head"><span class="n">✦</span>{isHi ? "विशेष फ़ीचर" : "Special features"}</span>
          <ul class="lesson-links">
            <li>
              <a
                href={`${base}/quantum-year-2025/`}
                class={currentSlug === "quantum-year-2025" ? "active" : ""}
              >{isHi ? "2025: क्वांटम का अंतरराष्ट्रीय वर्ष" : "2025: The International Year of Quantum"}</a>
            </li>
            <li>
              <a
                href={`${base}/labs/`}
                class={currentSlug === "labs" ? "active" : ""}
              >{isHi ? "क्वांटम लैब्स" : "Quantum Labs"}</a>
            </li>
            <li>
              <a
                href={`${base}/quantum-upanishads/`}
                class={currentSlug === "quantum-upanishads" ? "active" : ""}
              >{isHi ? "क्वांटम और उपनिषद" : "Quantum & the Upanishads"}</a>
            </li>
            <li>
              <a
                href={`${base}/quantum-bharat/mission/`}
                class={currentSlug === "quantum-bharat-mission" ? "active" : ""}
              >{isHi ? "क्वांटम भारत: राष्ट्रीय क्वांटम मिशन" : "Quantum Bharat: The National Quantum Mission"}</a>
            </li>
            <li>
              <a
                href={`${base}/quantum-bharat/experiments/`}
                class={currentSlug === "quantum-bharat-experiments" ? "active" : ""}
              >{isHi ? "क्वांटम भारत: लैब से युद्धक्षेत्र तक" : "Quantum Bharat: Lab to Battlefield"}</a>
            </li>
            <li>
              <a
                href={`${base}/quantum-computing-10-questions/`}
                class={currentSlug === "quantum-computing-10-questions" ? "active" : ""}
              >{isHi ? "10 सवालों में quantum computing" : "Quantum computing in 10 questions"}</a>
            </li>
          </ul>
        </div>
      </aside>

      <main data-pagefind-body>
        <span data-pagefind-filter="lang" hidden>{lang}</span>
        <div class="prose">
          <slot />
          {!noFooter && (
          <footer class="site-foot" data-pagefind-ignore>
            {t(lang, "footerText")}
          </footer>
          )}
        </div>
      </main>
    </div>

    <script>
      (function () {
        var root = document.documentElement;
        var isHi = root.lang === "hi";

        /* theme */
        try {
          var saved = localStorage.getItem("qlh-theme");
          if (saved) root.setAttribute("data-theme", saved);
        } catch (e) {}
        var themeBtn = document.getElementById("theme-toggle");
        if (themeBtn) themeBtn.addEventListener("click", function () {
          var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
          root.setAttribute("data-theme", next);
          try { localStorage.setItem("qlh-theme", next); } catch (e) {}
        });

        /* mobile sidebar */
        var menuBtn = document.getElementById("menu-toggle");
        var sidebar = document.getElementById("sidebar");
        if (menuBtn && sidebar) menuBtn.addEventListener("click", function () {
          sidebar.classList.toggle("open");
        });

        /* search — Pagefind full-text index (built into /pagefind/) */
        var input = document.getElementById("site-search");
        var results = document.getElementById("search-results");
        var pagefindApi = null;
        var searchTimer = null;
        function escHtml(s) {
          return String(s).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }
        function cleanTitle(t) { return String(t).split(" · ")[0]; }
        function pagefindReady() {
          if (pagefindApi) return Promise.resolve(pagefindApi);
          var pfUrl = "/pagefind/" + "pagefind.js"; /* built at runtime so the bundler leaves it alone */
          return import(/* @vite-ignore */ pfUrl).then(function (mod) {
            var ready = mod.init ? mod.init() : Promise.resolve();
            return ready.then(function () { pagefindApi = mod; return mod; });
          });
        }
        function runSearch(q) {
          if (!q) { results.hidden = true; results.innerHTML = ""; return; }
          pagefindReady().then(function (pf) {
            var withFilter = pf.search(q, { filters: { lang: isHi ? "hi" : "en" } });
            return withFilter.catch(function () { return pf.search(q); });
          }).then(function (res) {
            if (!res || input.value.trim() !== q) return;
            var list = (res.results || []).slice(0, 20);
            function noResults() {
              results.innerHTML = '<div class="search-none">' +
                escHtml(input.getAttribute("data-none") || "") + "</div>";
              results.hidden = false;
            }
            if (!list.length) { noResults(); return null; }
            return Promise.all(list.map(function (r) { return r.data(); })).then(function (datas) {
              if (input.value.trim() !== q) return;
              /* Pagefind degrades unknown words to short prefixes (even a single
                 character), which returns junk matches. Keep only results whose
                 title or excerpt actually contains a query word. */
              var words = q.toLowerCase().split(/\s+/).map(function (w) {
                return w.replace(/[^\p{L}\p{N}]/gu, "");
              }).filter(function (w) { return w.length; });
              var keep = datas.filter(function (d) {
                var hay = (((d.meta && d.meta.title) || "") + " " +
                  String(d.excerpt || "").replace(/<[^>]+>/g, " ")).toLowerCase();
                return words.some(function (w) { return hay.indexOf(w) !== -1; });
              }).slice(0, 8);
              if (!keep.length) { noResults(); return; }
              results.innerHTML = keep.map(function (d) {
                return '<a class="search-hit" href="' + escHtml(d.url) + '">' +
                  "<span>" + escHtml(cleanTitle((d.meta && d.meta.title) || "")) + "</span>" +
                  "<small>" + d.excerpt + "</small></a>";
              }).join("");
              results.hidden = false;
            });
          }).catch(function () { results.hidden = true; });
        }
        if (input) {
          input.addEventListener("input", function () {
            clearTimeout(searchTimer);
            var q = input.value.trim();
            searchTimer = setTimeout(function () { runSearch(q); }, 180);
          });
          input.addEventListener("focus", function () {
            pagefindReady().catch(function () {});
            if (input.value.trim()) runSearch(input.value.trim());
          });
          input.addEventListener("blur", function () { setTimeout(function () { results.hidden = true; }, 160); });
        }

        /* progress */
        function doneList() {
          try { return JSON.parse(localStorage.getItem("qlh-done") || "[]"); } catch (e) { return []; }
        }
        function saveDone(list) {
          try { localStorage.setItem("qlh-done", JSON.stringify(list)); } catch (e) {}
        }
        var total = parseInt(document.body.getAttribute("data-lesson-count") || "0", 10);
        function paintProgress() {
          var done = doneList();
          var pct = total ? Math.round((done.length / total) * 100) : 0;
          document.querySelectorAll("[data-progress-bar]").forEach(function (bar) { bar.style.width = pct + "%"; });
          document.querySelectorAll("[data-progress-text]").forEach(function (el) {
            el.textContent = isHi
              ? (total + " में से " + done.length + " पाठ पूर्ण")
              : (done.length + " of " + total + " lessons complete");
          });
          document.querySelectorAll("[data-lesson-link]").forEach(function (a) {
            if (done.indexOf(a.getAttribute("data-lesson-link")) !== -1) a.classList.add("done");
          });
          document.querySelectorAll(".lesson-row").forEach(function (row) {
            var link = row.querySelector("[data-lesson-link]");
            if (link && done.indexOf(link.getAttribute("data-lesson-link")) !== -1) row.classList.add("done");
          });
        }
        var completeBtn = document.querySelector("[data-complete]");
        function syncCompleteBtn() {
          if (!completeBtn) return;
          var slug = completeBtn.getAttribute("data-complete");
          var done = doneList().indexOf(slug) !== -1;
          completeBtn.textContent = done
            ? (isHi ? "✓ पूर्ण — वापस लेने के लिए क्लिक करें" : "✓ Completed — click to undo")
            : (isHi ? "पाठ पूर्ण चिह्नित करें" : "Mark lesson as complete");
          completeBtn.classList.toggle("is-done", done);
        }
        if (completeBtn) completeBtn.addEventListener("click", function () {
          var slug = completeBtn.getAttribute("data-complete");
          var done = doneList();
          var i = done.indexOf(slug);
          if (i === -1) done.push(slug); else done.splice(i, 1);
          saveDone(done); paintProgress(); syncCompleteBtn();
        });
        syncCompleteBtn(); paintProgress();

        /* quizzes */
        document.querySelectorAll("[data-quiz]").forEach(function (quiz) {
          var answered = 0, correct = 0;
          var qs = quiz.querySelectorAll(".quiz-q");
          qs.forEach(function (q) {
            var answer = parseInt(q.getAttribute("data-answer"), 10);
            q.querySelectorAll(".quiz-opt").forEach(function (opt) {
              opt.addEventListener("click", function () {
                if (q.classList.contains("locked")) return;
                q.classList.add("locked");
                var chosen = parseInt(opt.getAttribute("data-oi"), 10);
                q.querySelectorAll(".quiz-opt").forEach(function (o) {
                  var oi = parseInt(o.getAttribute("data-oi"), 10);
                  if (oi === answer) o.classList.add("correct");
                  else if (oi === chosen) o.classList.add("wrong");
                  o.disabled = true;
                });
                if (chosen === answer) correct++;
                answered++;
                var why = q.querySelector(".quiz-why");
                if (why) why.hidden = false;
                if (answered === qs.length) {
                  var score = quiz.querySelector(".quiz-score");
                  score.hidden = false;
                  score.textContent = isHi
                    ? ("आपने " + qs.length + " में से " + correct + " सही किए।" +
                      (correct === qs.length ? " बिल्कुल सही — अब अगले पाठ पर चलें।" : " पाठ को एक बार और देख लें, फिर आगे बढ़ें।"))
                    : ("You got " + correct + " out of " + qs.length + " right." +
                      (correct === qs.length ? " Perfect — on to the next lesson." : " Skim the lesson once more, then move on."));
                }
              });
            });
          });
        });

        /* keyboard page turning */
        document.addEventListener("keydown", function (e) {
          if (e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA")) return;
          var prev = document.body.getAttribute("data-prev");
          var next = document.body.getAttribute("data-next");
          if (e.key === "ArrowLeft" && prev) window.location.href = prev;
          if (e.key === "ArrowRight" && next) window.location.href = next;
        });

        /* math rendering */
        function renderMath() {
          if (window.renderMathInElement) {
            renderMathInElement(document.body, {
              delimiters: [
                { left: "$$", right: "$$", display: true },
                { left: "\\(", right: "\\)", display: false },
                { left: "\\[", right: "\\]", display: true },
              ],
              throwOnError: false,
            });
          }
        }
        if (document.readyState === "complete") renderMath();
        else window.addEventListener("load", renderMath);
      })();
    </script>
    {/* Site-wide login wall. Talks ONLY to the auth interface in /auth/
        (see public/auth/README.md) — zero provider-specific code here.
        Swap providers by adding an adapter + one word in /auth/config.js.
        NOTE: this script is intentionally NOT wrapped in a JSX conditional.
        Astro renders conditional <script> tags unconditionally, which caused
        an infinite /login/ -> /login/?next=... redirect loop. Instead the
        script exempts itself at runtime via body[data-nogate="1"], which the
        login pages set through the layout's noGate prop. */}
      <script>
        (function () {
          if (document.body && document.body.dataset.nogate === "1") return;
          var AUTH_BASE = "/auth/";
          var gate = document.getElementById("auth-gate");
          var HI = document.documentElement.lang === "hi";
          function hideGate() { if (gate) gate.style.display = "none"; }
          function gateMsg(t) { var m = gate && gate.querySelector(".gate-msg"); if (m) m.textContent = t; }
          function unreachable() {
            gateMsg(HI
              ? "साइन-इन सेवा नहीं मिल रही — कनेक्शन जाँचें और पेज reload करें।"
              : "Sign-in service unreachable — check your connection and reload.");
          }
          function loginUrl(denied, unverified) {
            var base = HI ? "/hi/login/" : "/login/";
            var next = encodeURIComponent(window.location.pathname + window.location.search);
            return base + "?next=" + next + (denied ? "&denied=1" : "") + (unverified ? "&unverified=1" : "");
          }
          import(/* @vite-ignore */ AUTH_BASE + "config.js").then(function () {
            return import(/* @vite-ignore */ AUTH_BASE + "index.js");
          }).then(function (mod) {
            var auth = mod.auth;
            /* Auth service not wired yet — leave the site public until it is. */
            if (!auth.configured) { hideGate(); return; }
            var settled = false;
            auth.ready.catch(unreachable);
            auth.onAuthChange(function (user, info) {
              if (info && info.denied) { window.location.replace(loginUrl(true, false)); return; }
              if (info && info.unverified) { window.location.replace(loginUrl(false, true)); return; }
              if (!user) { window.location.replace(loginUrl(false, false)); return; }
              settled = true;
              document.body.classList.add("is-authed");
              hideGate();
              var chip = document.getElementById("user-chip");
              if (chip) {
                chip.hidden = false;
                chip.textContent = user.email || user.displayName || "";
                chip.title = user.email || user.displayName || "";
              }
              var so = document.getElementById("signout-btn");
              if (so) {
                so.hidden = false;
                so.addEventListener("click", function () {
                  auth.signOut().then(function () { window.location.replace(loginUrl(false, false)); });
                });
              }
            }).catch(unreachable);
            setTimeout(function () {
              if (!settled && gate && gate.style.display !== "none") {
                gateMsg(HI
                  ? "साइन-इन में देर हो रही है — पेज reload करें।"
                  : "Sign-in is taking too long — reload the page.");
              }
            }, 20000);
          }).catch(unreachable);
        })();
      </script>
  </body>
</html>
